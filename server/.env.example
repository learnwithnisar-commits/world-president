# WORLD PRESIDENT — backend env
# Copy to .env for local runs. Never commit a real .env with secrets.

# Port the server listens on (default 3000)
PORT=3000

# Seconds per game day (tick). Admins can change it live via /api/admin/speed (10-600).
TICK_SECONDS=60

# Database. Leave UNSET for local SQLite (world.db in the project root).
# Set to a Supabase Postgres connection string for hosted deploys, e.g.:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# Local SQLite file override (only used when DATABASE_URL is unset).
# DB_PATH=./world.db
